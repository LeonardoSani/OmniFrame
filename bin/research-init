#!/usr/bin/env bash
#
# research-init -- create a research project: the brain, and its code folder.
#
#     cd ~/Projects
#     research-init MYPROJ
#
# makes MYPROJ_Brain/ (the brain, a git repo) and MYPROJ_Brain/MYPROJ/ (the code,
# a uv project that can later be exported alone into a public repo).
#
# The template content is cloned from the template repo on every run, so a
# project always gets the current version. Files that already exist are left
# alone unless --force is given, so running it again inside a project is safe.

set -euo pipefail

TEMPLATE_REPO="${RESEARCH_TEMPLATE_REPO:-https://github.com/LeonardoSani/OmniFrame.git}"
TEMPLATE_REF="${RESEARCH_TEMPLATE_REF:-main}"
TEMPLATE_SUBDIR="${RESEARCH_TEMPLATE_SUBDIR:-template}"

die() { printf 'research-init: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<'USAGE'
usage: research-init [options] [NAME]

Creates NAME_Brain/ from the research template, substituting the template
tokens in file contents and in path names, then runs `git init` there and
`uv init` in its code folder NAME_Brain/NAME/. NAME may be a path; a trailing
_Brain is not doubled. Without NAME, the current folder is used, and its name
must end in _Brain.

options:
  -n, --name NAME     project display name  (default: NAME)
  -p, --pkg PKG       python package name   (default: the slug, with underscores)
  -a, --author NAME   author                (default: git config user.name)
      --repo URL      template repo url, or a local path
      --ref REF       branch/tag/commit to clone              (default: main)
  -f, --force         overwrite files that already exist
      --dry-run       print what would happen, write nothing
  -h, --help          this text

tokens, replaced in file contents and in file/directory names:
  __PROJECT_NAME__  __CODE_DIR__  __SLUG__  __PKG__  __AUTHOR__  __YEAR__  __DATE__

A template with no tokens in it is simply copied as-is.
.gitkeep marks a directory to create; it and .DS_Store are never copied.
A template file named <name>.append is appended to an existing <name> instead of
being skipped, or written as <name> if there is nothing there yet.

environment:
  RESEARCH_TEMPLATE_REPO    same as --repo
  RESEARCH_TEMPLATE_REF     same as --ref
  RESEARCH_TEMPLATE_SUBDIR  subdirectory of the repo holding the skeleton
USAGE
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//'
}

target=""
opt_name=""
opt_pkg=""
opt_author=""
force=0
dry_run=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name)   opt_name="${2:-}";      shift 2 ;;
    -p|--pkg)    opt_pkg="${2:-}";       shift 2 ;;
    -a|--author) opt_author="${2:-}";    shift 2 ;;
    --repo)      TEMPLATE_REPO="${2:-}"; shift 2 ;;
    --ref)       TEMPLATE_REF="${2:-}";  shift 2 ;;
    -f|--force)  force=1;                shift ;;
    --dry-run)   dry_run=1;              shift ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    -*)          die "unknown option: $1 (try --help)" ;;
    *)           [[ -n "$target" ]] && die "only one NAME may be given"
                 target="$1";            shift ;;
  esac
done

if [[ -z "$target" ]]; then
  [[ "$(basename "$PWD")" == *_Brain ]] \
    || die "give a NAME (research-init MYPROJ), or run it inside a NAME_Brain folder"
  target="$PWD"
fi
target="${target%/}"
[[ "$target" == *_Brain ]] || target="${target}_Brain"

parent="$(dirname "$target")"
[[ -d "$parent" ]] || die "no such directory: $parent"
target="$(cd "$parent" && pwd -P)/$(basename "$target")"
[[ $dry_run -eq 1 ]] || mkdir -p "$target"

command -v git >/dev/null 2>&1 || die "git is required"
command -v perl >/dev/null 2>&1 || die "perl is required"
command -v uv >/dev/null 2>&1 || die "uv is required (https://docs.astral.sh/uv/)"

# --- work out the token values ----------------------------------------------

code_dir="$(basename "$target")"
code_dir="${code_dir%_Brain}"
[[ -n "$code_dir" ]] || die "the folder name needs a NAME before _Brain"
code="$target/$code_dir"

project_name="${opt_name:-$code_dir}"
slug="$(slugify "$project_name")"
[[ -n "$slug" ]] || die "could not derive a slug from '$project_name'; pass --name"

pkg="${opt_pkg:-$slug}"
pkg="$(printf '%s' "$pkg" | tr '[:upper:]-' '[:lower:]_')"

if [[ -n "$opt_author" ]]; then
  author="$opt_author"
else
  author="$(git config user.name 2>/dev/null || true)"
  [[ -n "$author" ]] || author="${USER:-unknown}"
fi

export T_PROJECT_NAME="$project_name"
export T_CODE_DIR="$code_dir"
export T_SLUG="$slug"
export T_PKG="$pkg"
export T_AUTHOR="$author"
T_YEAR="$(date +%Y)"; export T_YEAR
T_DATE="$(date +%Y-%m-%d)"; export T_DATE

# --- fetch the skeleton ------------------------------------------------------

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

if [[ -d "$TEMPLATE_REPO" ]]; then
  src="$TEMPLATE_REPO/$TEMPLATE_SUBDIR"
  origin="$TEMPLATE_REPO (local)"
else
  git clone --quiet --depth 1 --branch "$TEMPLATE_REF" "$TEMPLATE_REPO" "$tmp/repo" \
    || die "could not clone $TEMPLATE_REPO at ref '$TEMPLATE_REF'"
  src="$tmp/repo/$TEMPLATE_SUBDIR"
  origin="$TEMPLATE_REPO@$TEMPLATE_REF"
fi

[[ -d "$src" ]] || die "template repo has no '$TEMPLATE_SUBDIR/' directory"
src="$(cd "$src" && pwd -P)"

# --- copy --------------------------------------------------------------------

expand_path() {
  local p="$1"
  p="${p//__PROJECT_NAME__/$T_PROJECT_NAME}"
  p="${p//__CODE_DIR__/$T_CODE_DIR}"
  p="${p//__SLUG__/$T_SLUG}"
  p="${p//__PKG__/$T_PKG}"
  p="${p//__AUTHOR__/$T_AUTHOR}"
  p="${p//__YEAR__/$T_YEAR}"
  p="${p//__DATE__/$T_DATE}"
  printf '%s' "$p"
}

is_text() {
  [[ ! -s "$1" ]] && return 0            # empty counts as text
  LC_ALL=C grep -Iq . "$1" 2>/dev/null
}

substitute() {
  perl -pe '
    s/__PROJECT_NAME__/$ENV{T_PROJECT_NAME}/g;
    s/__CODE_DIR__/$ENV{T_CODE_DIR}/g;
    s/__SLUG__/$ENV{T_SLUG}/g;
    s/__PKG__/$ENV{T_PKG}/g;
    s/__AUTHOR__/$ENV{T_AUTHOR}/g;
    s/__YEAR__/$ENV{T_YEAR}/g;
    s/__DATE__/$ENV{T_DATE}/g;
  ' "$1"
}

# true when the file exists and does not end in a newline
needs_newline() {
  [[ -s "$1" ]] && [[ -n "$(tail -c 1 "$1")" ]]
}

info "template : $origin"
info "target   : $target"
info "name     : $project_name    code: $code_dir/    pkg: $pkg    author: $author"
[[ $dry_run -eq 1 ]] && info "(dry run -- nothing is written)"
info ""

n_new=0; n_skip=0; n_over=0; n_dir=0; n_appd=0

# empty directories carry meaning in a skeleton, so recreate those too
while IFS= read -r dir; do
  rel="${dir#"$src"}"; rel="${rel#/}"
  [[ -z "$rel" ]] && continue
  dest="$target/$(expand_path "$rel")"
  [[ -d "$dest" ]] && continue
  info "  dir   $(expand_path "$rel")/"
  n_dir=$((n_dir + 1))
  [[ $dry_run -eq 0 ]] && mkdir -p "$dest"
done < <(find "$src" -type d -empty | sort)

while IFS= read -r file; do
  base="$(basename "$file")"
  [[ "$base" == ".DS_Store" ]] && continue

  # a .gitkeep is not copied, but it does mean "this directory should exist"
  if [[ "$base" == ".gitkeep" ]]; then
    rel="$(dirname "${file#"$src"/}")"
    [[ "$rel" == "." ]] && continue
    dest="$target/$(expand_path "$rel")"
    [[ -d "$dest" ]] && continue
    info "  dir   $(expand_path "$rel")/"
    n_dir=$((n_dir + 1))
    [[ $dry_run -eq 0 ]] && mkdir -p "$dest"
    continue
  fi

  rel="${file#"$src"/}"
  dest_rel="$(expand_path "$rel")"

  # <name>.append is merged into an existing <name> rather than skipped, so the
  # template can add to a file uv already wrote
  append=0
  if [[ "$dest_rel" == *.append ]]; then
    append=1
    dest_rel="${dest_rel%.append}"
  fi
  dest="$target/$dest_rel"

  if [[ -e "$dest" ]]; then
    if [[ $append -eq 1 ]]; then
      # re-running must not append the same block twice: the first non-empty
      # line of the block is its marker
      marker="$(substitute "$file" | grep -m1 -v '^[[:space:]]*$' || true)"
      if [[ -n "$marker" ]] && grep -qxF "$marker" "$dest" 2>/dev/null; then
        info "  same  $dest_rel (already appended)"
        n_skip=$((n_skip + 1))
        continue
      fi
      info "  appd  $dest_rel"
      n_appd=$((n_appd + 1))
    elif [[ $force -eq 0 ]]; then
      info "  skip  $dest_rel (exists)"
      n_skip=$((n_skip + 1))
      continue
    else
      info "  over  $dest_rel"
      n_over=$((n_over + 1))
    fi
  else
    info "  new   $dest_rel"
    n_new=$((n_new + 1))
  fi

  [[ $dry_run -eq 1 ]] && continue

  mkdir -p "$(dirname "$dest")"
  if [[ $append -eq 1 && -e "$dest" ]]; then
    needs_newline "$dest" && printf '\n' >> "$dest"
    substitute "$file" >> "$dest"
  elif is_text "$file"; then
    substitute "$file" > "$dest"
  else
    cp "$file" "$dest"
  fi
  [[ -x "$file" ]] && chmod +x "$dest"
done < <(find "$src" -type f | sort)

# --- the brain repo and the code project --------------------------------------

# the brain is the one git repo, and it tracks the code folder too; uv must not
# start a second repo inside it
info ""
if [[ -e "$target/.git" ]]; then
  info "  same  git repo (already there)"
else
  info "  git   git init"
  [[ $dry_run -eq 0 ]] && git -C "$target" init --quiet
fi

if [[ -f "$code/pyproject.toml" ]]; then
  info "  same  $code_dir/pyproject.toml (uv project already there)"
else
  info "  uv    uv init --vcs none in $code_dir/"
  if [[ $dry_run -eq 0 ]]; then
    mkdir -p "$code"
    (cd "$code" && uv init --quiet --vcs none --name "$pkg") \
      || die "uv init failed in $code"
  fi
fi

info ""
info "done: $n_new new, $n_appd appended, $n_over overwritten, $n_skip skipped, $n_dir empty dirs"
if [[ $n_new -eq 0 && $n_over -eq 0 && $n_dir -eq 0 && $n_appd -eq 0 && $n_skip -eq 0 ]]; then
  info "nothing was copied -- is $TEMPLATE_SUBDIR/ empty in the template repo?"
elif [[ $n_skip -gt 0 && $force -eq 0 ]]; then
  info "re-run with --force to overwrite the skipped files"
fi
