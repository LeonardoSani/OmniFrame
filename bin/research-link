#!/usr/bin/env bash
#
# research-link -- make sure ~/.local/bin points at the scripts in this clone.
#
# Run it once after cloning the repo on a new machine:
#
#     git clone https://github.com/LeonardoSani/OmniFrame.git
#     ./OmniFrame/bin/research-link
#
# Safe to run any number of times. It reports "already consistent" and changes
# nothing when the links are already correct, so it doubles as a health check:
#
#     research-link --check     # verify only, non-zero exit if anything is wrong

set -euo pipefail

BIN_DIR="${RESEARCH_BIN_DIR:-$HOME/.local/bin}"
# every script in bin/ that belongs on PATH
SCRIPTS="research-init research-convert"

die() { printf 'research-link: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<'USAGE'
usage: research-link [--check] [--force] [--bin-dir DIR]

Ensures DIR/<script> is a symlink to bin/<script> in this clone, for each of:
research-init, research-convert.

  --check         report only; exit 1 if any link is missing or wrong
  --force         replace whatever is in the way (wrong link, or a real file)
  --bin-dir DIR   where to put the links     (default: ~/.local/bin)
  -h, --help      this text

environment:
  RESEARCH_BIN_DIR   same as --bin-dir
USAGE
}

check_only=0
force=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)   check_only=1;      shift ;;
    --force)   force=1;           shift ;;
    --bin-dir) BIN_DIR="${2:-}";  shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*)        die "unknown option: $1 (try --help)" ;;
    *)         die "unexpected argument: $1 (try --help)" ;;
  esac
done

# resolve this script's own directory, following a symlink if we were invoked
# through one, so the links always point at the real files in the clone
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link_target="$(readlink "$self")"
  case "$link_target" in
    /*) self="$link_target" ;;
    *)  self="$(cd "$(dirname "$self")" && pwd -P)/$link_target" ;;
  esac
done
repo_bin="$(cd "$(dirname "$self")" && pwd -P)"
[[ -x "$self" ]] || chmod +x "$self"

info "clone  : $repo_bin"
info "bin    : $BIN_DIR"
info ""

# --- one script ---------------------------------------------------------------
# echoes its state, returns 0 when it ends up correct, 1 when it needs attention

link_one() {
  local name="$1"
  local src="$repo_bin/$name"
  local dst="$BIN_DIR/$name"

  if [[ ! -f "$src" ]]; then
    printf '  %-18s MISSING from the clone\n' "$name"
    return 1
  fi

  if [[ ! -x "$src" ]]; then
    if [[ $check_only -eq 1 ]]; then
      printf '  %-18s WRONG -- not executable in the clone\n' "$name"
      return 1
    fi
    chmod +x "$src"
  fi

  if [[ -L "$dst" ]]; then
    local current current_abs
    current="$(readlink "$dst")"
    case "$current" in
      /*) current_abs="$current" ;;
      *)  current_abs="$(cd "$BIN_DIR" && pwd -P)/$current" ;;
    esac

    if [[ "$current_abs" == "$src" ]]; then
      printf '  %-18s ok -- already consistent\n' "$name"
      return 0
    fi

    if [[ ! -e "$dst" ]]; then
      printf '  %-18s WRONG -- dangling symlink to %s\n' "$name" "$current"
    else
      printf '  %-18s WRONG -- points to %s\n' "$name" "$current_abs"
    fi
    if [[ $check_only -eq 1 ]]; then
      printf '  %-18s   run research-link to repoint it\n' ""
      return 1
    fi
    rm "$dst"
    ln -s "$src" "$dst"
    printf '  %-18s fixed -- repointed to this clone\n' "$name"
    return 0
  fi

  if [[ -e "$dst" ]]; then
    printf '  %-18s WRONG -- a real file is in the way (not a symlink)\n' "$name"
    if [[ $check_only -eq 1 ]]; then
      printf '  %-18s   run research-link --force to replace it\n' ""
      return 1
    fi
    if [[ $force -eq 0 ]]; then
      printf '  %-18s   refusing to delete it; re-run with --force\n' ""
      return 1
    fi
    local backup="$dst.bak.$(date +%Y%m%d%H%M%S)"
    mv "$dst" "$backup"
    ln -s "$src" "$dst"
    printf '  %-18s fixed -- old file saved as %s\n' "$name" "$(basename "$backup")"
    return 0
  fi

  if [[ $check_only -eq 1 ]]; then
    printf '  %-18s WRONG -- no link yet\n' "$name"
    printf '  %-18s   run research-link to create it\n' ""
    return 1
  fi

  mkdir -p "$BIN_DIR"
  ln -s "$src" "$dst"
  printf '  %-18s linked\n' "$name"
  return 0
}

bad=0
for name in $SCRIPTS; do
  link_one "$name" || bad=$((bad + 1))
done

case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) info ""
     info "note   : $BIN_DIR is not on your PATH."
     info "         add this to ~/.zshrc:  export PATH=\"$BIN_DIR:\$PATH\"" ;;
esac

if [[ $bad -gt 0 ]]; then
  info ""
  info "$bad of the above need attention"
  exit 1
fi
exit 0
